# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/dist/
/coverage/
/.tooling/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Android signing material and machine-specific configuration
/android/key.properties
/android/local.properties
/android/app/*.jks
/android/app/*.keystore

# Generated iOS files (regenerated by Flutter/CocoaPods, including Xcode Cloud)
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/ephemeral/
/ios/Pods/
/ios/.symlinks/

# Local build caches and release artifacts retained on the external disk
/android/.gradle/
/android/.android-build-cache-*/
/.android-build-cache-*/
/.external-build-recovery-*/
/*.apk
/*.aab
